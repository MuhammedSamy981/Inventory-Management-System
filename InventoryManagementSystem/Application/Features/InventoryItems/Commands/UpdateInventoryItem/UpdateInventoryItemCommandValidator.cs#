using FluentValidation;

namespace InventoryManagementSystem.Application.InventoryItems.Commands
{
    public class UpdateInventoryItemCommandValidator : AbstractValidator<UpdateInventoryItemCommand>
{
    public UpdateInventoryItemCommandValidator()
    {

           RuleFor(ii => ii.InventoryId).NotEmpty().WithMessage("InventoryId is required");

            RuleFor(ii=> ii.ItemId).NotEmpty().WithMessage("ItemId is required");

            RuleFor(ii => ii.Quantity)
                .NotEmpty().WithMessage("Quantity is required")
                .GreaterThan(0).WithMessage("Quantity must be greater than 0");


    }
}
}